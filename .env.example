# file loaded by `docker-compose` when starting the services. It contains environment variables used by
# the services defined in the `docker-compose.yml` file.
# Make sure to update these variables with secure values before starting the services.
#
# Portainer admin credentials
PORTAINER_ADMIN_USERNAME=admin
PORTAINER_ADMIN_PASSWORD=<your_secure_password_here>

# Atlantis admin credentials

# vault credentials
VAULT_DEV_ROOT_TOKEN_ID=<your_secure_token_here>


# PostgreSQL main credentials
PG_USER=postgres
PG_PASSWORD=postgres_password

# pgAdmin credentials
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=pgadmin_password

# MySQL/MariaDB credentials
MYSQL_ROOT_PASSWORD=mysql_root_password
MYSQL_USER=mysql_user
MYSQL_PASSWORD=mysql_password

# MongoDB credentials
MONGO_INITDB_ROOT_USERNAME=mongo
MONGO_INITDB_ROOT_PASSWORD=mongo
# Mongo Express credentials
ME_WEB_USERNAME=admin
ME_WEB_PASSWORD=password

# ClickHouse credentials
CLICKHOUSE_DB="default"
CLICKHOUSE_USER="clickhouse"
CLICKHOUSE_PASSWORD="clickhouse"

# Keycloak credentials
KC_DB_USERNAME=keycloak_user
KC_DB_PASSWORD=keycloak_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password

# MinIO credentials
MINIO_ROOT_USER=minioAccessKey
MINIO_ROOT_PASSWORD=minioSecretKey

# Grafana admin
GRAFANA_ADMIN_PASSWORD=admin

# Redis credentials
REDIS_PASSWORD=redis_password

# RabbitMQ credentials
RABBITMQ_DEFAULT_USER=rabbitmq_user
RABBITMQ_DEFAULT_PASS=rabbitmq_password

