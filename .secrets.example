# .secrets.example - Template for sensitive environment variables
# Copy this file to .secrets and fill in your actual values
# The .secrets file should be added to .gitignore to prevent committing secrets

# Vault secrets
export VAULT_TOKEN="root"

# Expose Vault token to Terraform as `TF_VAR_vault_token` so modules can
# read `var.vault_token` when running `terraform`.
export TF_VAR_vault_token="root"

# ArgoCD secrets
export ARGOCD_PASSWORD="your-argocd-password"

# Keycloak secrets
export KEYCLOAK_PASSWORD="your-keycloak-password"

# Database secrets
export POSTGRES_PASSWORD="your-postgres-password"
export MONGODB_ROOT_PASSWORD="your-mongodb-password"
export CLICKHOUSE_PASSWORD="your-clickhouse-password"

# Minio secrets
export MINIO_ROOT_PASSWORD="your-minio-password"

# GitHub tokens (if needed)
export GITHUB_TOKEN="your-github-token"

# Docker registry credentials (if needed)
export DOCKER_REGISTRY_PASSWORD="your-registry-password"

# GitHub App
export GITHUB_ACCOUNT=<your-account-slug> # eg thatmlopsguy
export GITHUB_APP_KEY_PATH=<path-to-the-generate-private-key>
export GITHUB_APP_ID=<your-github-app-id>
# https://github.com/settings/installations/<your-github-app-installation-id>
export GITHUB_APP_INSTALLATION_ID=<your-github-app-installation-id>

# MinIO admin credentials
export MC_ADMIN_USER=minioAccessKey
export MC_ADMIN_PASSWORD=minioSecretKey
# MinIO per-bucket user credentials
export MINIO_VELERO_USER="velero"
export MINIO_VELERO_PASSWORD=""
export MINIO_LOKI_USER="loki"
export MINIO_LOKI_PASSWORD=""
export MINIO_TEMPO_USER="tempo"
export MINIO_TEMPO_PASSWORD=""
export MINIO_VICTORIA_METRICS_USER="victoriametrics"
export MINIO_VICTORIA_METRICS_PASSWORD=""
export MINIO_VICTORIA_TRACES_USER="victoriatraces"
export MINIO_VICTORIA_TRACES_PASSWORD=""
export MINIO_VICTORIA_LOGS_USER="victorialogs"
export MINIO_VICTORIA_LOGS_PASSWORD=""
export MINIO_REPORT_PORTAL_USER="reportportal"
export MINIO_REPORT_PORTAL_PASSWORD=""
export MINIO_MLFLOW_USER="mlflow"
export MINIO_MLFLOW_PASSWORD=""
export MINIO_LANGFUSE_USER="langfuse"
export MINIO_LANGFUSE_PASSWORD=""
export MINIO_PYROSCOPE_USER="pyroscope"
export MINIO_PYROSCOPE_PASSWORD=""
export MINIO_HARBOR_USER="harbor"
export MINIO_HARBOR_PASSWORD=""
export MINIO_CHARTMUSEUM_USER="chartmuseum"
export MINIO_CHARTMUSEUM_PASSWORD=""
